# Instance A (control plane) env. Copy to .env and fill in.
# No LLM key is needed here — the control plane only proxies to the agents.
RUNTIME_IMAGE=asia-southeast1-docker.pkg.dev/PROJECT/runtime/runtime:git-COMMIT
#
# NUTRITION_GO_TOKEN MUST match RUNTIME_AGENT_AUTH_TOKEN on Instance B.
# Every token below MUST match RUNTIME_AGENT_AUTH_TOKEN on its agent container.
NUTRITION_GO_TOKEN=replace-with-a-long-random-token
NUTRITION_OPENAI_TOKEN=replace-with-a-different-long-random-token
HELLO_CLAUDE_TOKEN=replace-with-another-long-random-token
FOOD_LABEL_TOKEN=replace-with-another-long-random-token

# --- Identity (REQUIRED — the control plane is exposed publicly via Caddy) ---
# RUNTIME_ADMIN_BOOTSTRAP: a long random hex string; the one-time superuser key
#   used to seed the first admin, after which every /ui + API request needs a
#   bearer. Generate: openssl rand -hex 32
# RUNTIME_SECRETS_KEYS / RUNTIME_SECRETS_PRIMARY: AES keyring for the secrets
#   broker. Generate a key: openssl rand -base64 32  (then KEYID:THATVALUE).
RUNTIME_ADMIN_BOOTSTRAP=replace-with-openssl-rand-hex-32
# Initial provisioning uses the bootstrap while the identity database is empty.
# Once a tenant key exists, restart runtimed: the bootstrap is ignored. Set this
# to 1 only for a deliberate, temporary recovery window, then return it to 0.
RUNTIME_ADMIN_BREAK_GLASS=0
RUNTIME_SECRETS_KEYS=primary:replace-with-openssl-rand-base64-32
RUNTIME_SECRETS_PRIMARY=primary

# Grafana has no anonymous access. Generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# --- Caddy TLS (public HTTPS) ---
# Defaults bake in for the live deploy; override here for a different host/email.
SITE_ADDRESS=runtime.sausheong.com
ACME_EMAIL=admin@sausheong.com

# --- OIDC human login (OPTIONAL — enables "Sign in with Google" on the console) ---
# When set, the console landing page (/ and /ui/login) shows a Google sign-in
# button and verified-email logins are matched against the Users allow-list
# (onboarding page). Without these, OIDC is off and login is service-key only.
#
# NOTE: docker-compose.yml passes these through explicitly (environment:), so
# they must be set in BOTH this .env AND listed in the runtimed service block —
# they already are; just fill in the values here.
#
# Create a Google OAuth 2.0 "Web application" client; authorized redirect URI
# MUST be https://<SITE_ADDRESS>/ui/callback. The console resolves the user from
# the verified `email` claim (Google's `sub` is an opaque numeric id).
RUNTIME_OIDC_ISSUER=
RUNTIME_OIDC_CLIENT_ID=
RUNTIME_OIDC_CLIENT_SECRET=
RUNTIME_OIDC_REDIRECT_URL=

# Instance C (second container) — Claude Agent SDK agent env, SECRETS ONLY.
# Copy to .env.
#
# LLM routing (ANTHROPIC_BASE_URL + ANTHROPIC_MODEL) is NOT here: it lives in the
# shared ../llm.env, loaded by docker-compose.yml's env_file.
#
# The litellm proxy uses ONE key for all models, so this is the same key value
# already in agent-python/.env (as OPENAI_API_KEY) — just under ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=replace-with-your-litellm-proxy-key

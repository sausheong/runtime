# Instance C (Python agent) env — SECRETS ONLY. Copy to .env and fill in.
#
# LLM routing (OPENAI_BASE_URL + OPENAI_MODEL) is NOT here: it lives in the shared
# ../llm.env, loaded by docker-compose.yml's env_file.
NUTRITION_OPENAI_IMAGE=asia-southeast1-docker.pkg.dev/PROJECT/runtime/nutrition-openai:git-COMMIT
#
# Shared bearer for A -> this agent. Generate with `openssl rand -hex 32` and
# copy the same value to control-plane/.env.
NUTRITION_OPENAI_TOKEN=replace-with-a-long-random-token
#
# Your LiteLLM proxy key (the model routing comes from ../llm.env).
OPENAI_API_KEY=sk-your-litellm-proxy-key

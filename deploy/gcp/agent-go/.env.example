# Instance B (Go agent) env — SECRETS ONLY. Copy to .env and fill in.
#
# LLM routing (OPENAI_BASE_URL + OPENAI_MODEL) is NOT here: it lives in the shared
# ../llm.env, loaded by docker-compose.yml's env_file. This file holds only the
# per-instance secrets.
RUNTIME_IMAGE=asia-southeast1-docker.pkg.dev/PROJECT/runtime/runtime:git-COMMIT
#
# NUTRITION_GO_TOKEN MUST match NUTRITION_GO_TOKEN on Instance A (control plane).
NUTRITION_GO_TOKEN=replace-with-a-long-random-token

# Your LiteLLM proxy key (the model routing comes from ../llm.env).
OPENAI_API_KEY=sk-your-litellm-proxy-key
